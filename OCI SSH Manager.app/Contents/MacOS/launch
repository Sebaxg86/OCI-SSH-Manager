#!/bin/zsh
APP_DIR="${0:A:h:h:h:h}"
export PATH="/opt/homebrew/opt/python@3.13/libexec/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PYTHONDONTWRITEBYTECODE=1
if ! python3 -c 'import tkinter' >/dev/null 2>&1; then
    /usr/bin/osascript -e 'display alert "Falta Tkinter" message "Instala el componente Tkinter para tu versión de Python. Consulta README.md."'
    exit 1
fi
exec python3 "$APP_DIR/gui.py"
